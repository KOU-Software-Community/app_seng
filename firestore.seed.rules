rules_version = '2';

// GEÇİCİ — SADECE `npm run seed` İÇİN
//
// Kullanım:
//   1. Bu dosyanın tamamını Firebase Console → Firestore Database → Rules
//      sekmesine yapıştırıp "Publish" deyin.
//   2. Terminalde `npm run seed` çalıştırın.
//   3. Bittiğinde MUTLAKA firestore.rules dosyasındaki asıl kuralları yapıştırıp
//      tekrar "Publish" deyin.
//
// Bu kurallar yalnızca events/archive koleksiyonlarına yazmayı açar. Kayıtlar
// (registrations) ve diğer her şey burada da kapalıdır.
service cloud.firestore {
  match /databases/{database}/documents {

    match /events/{eventId} {
      allow read: if true;
      allow write: if true;   // ← seed bitince firestore.rules'a geri dönün
    }

    match /archive/{entryId} {
      allow read: if true;
      allow write: if true;   // ← seed bitince firestore.rules'a geri dönün
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

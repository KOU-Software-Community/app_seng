{
  "expo": {
    "name": "KOÜ Yazılım Kulübü",
    "slug": "kou-yazilim-kulubu",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kykapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#0389BC",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.akadirr1.sengkou",
      "buildNumber": "5",
      "infoPlist": {
        "CFBundleDisplayName": "KOÜ Yazılım",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.akadirr1.sengkou",
      "versionCode": 3,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#001B4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#001B4A"
        }
      ],
      "expo-build-properties",
      {
        "ios": {
          "deploymentTarget": "18.7.8"
        }
      }
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd103f6a-a138-4567-8e9e-e01290e32705"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dd103f6a-a138-4567-8e9e-e01290e32705"
    }
  }
}
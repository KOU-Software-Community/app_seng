# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — Firebase config lives here, never commit it
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# EAS
.eas/

# Store credentials — never commit
*.jks
*.keystore
play-store-key.json
AuthKey_*.p8

# Firebase service account keys — never commit.
# Unlike the EXPO_PUBLIC_* client config (which ships inside the app by design
# and is protected by firestore.rules), an Admin SDK key bypasses the rules
# entirely: full read/write on the whole database. The push-notification sender
# script needs one locally; it must never reach the repo.
*firebase-adminsdk*.json
service-account*.json
serviceAccountKey*.json
google-services.json
GoogleService-Info.plist

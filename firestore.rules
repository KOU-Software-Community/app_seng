rules_version = '2';

// KOÜ Yazılım Kulübü — Firestore Security Rules
//
// YAYINLAMA
//   npm run rules:deploy
//
// Bu dosya depoda durduğu sürece hiçbir şey yapmaz. Firestore kuralları
// projeden okur, depodan değil — yayınlanmamışsa Firestore varsayılanı
// geçerlidir ve o her şeyi reddeder. Uygulamanın
// "Missing or insufficient permissions" demesinin sebebi budur ve dosyaya
// bakarak anlaşılmaz: dosya doğrudur, yayınlanmamıştır.
//
// Elle yapmak isterseniz: Firebase Console → Firestore Database → Rules →
// yapıştır → Publish. Script'in tercih edilme sebebi, yayınlanan sürümün
// depodakiyle aynı olduğunu garanti etmesi.
//
// Neden önemli: uygulamadaki Firebase config (apiKey vb.) derleme sırasında
// pakete gömülür, yani uygulamayı kuran herkes ona ulaşabilir. Veriyi koruyan şey
// o anahtar değil, aşağıdaki kurallardır.
service cloud.firestore {
  match /databases/{database}/documents {

    // Etkinlikler herkese açık okunur; yazma yalnızca yönetim panelinden
    // (Admin SDK, bu kuralları görmez). Arşiv de burada: tarihi geçmiş etkinlik.
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // `archive` koleksiyonu buradaydı. Arşiv artık ayrı bir veri değil: tarihi
    // geçmiş `events` kaydının kendisi. Ayrı tutmak aynı gerçek etkinliği iki
    // kez girmek demekti.

    // Kayıtlar: öğrenci kendi kaydını oluşturabilir, ama kimse başkasının
    // kaydını okuyamaz veya değiştiremez. Kulüp yönetimi kayıtları konsoldan
    // veya Admin SDK ile görür.
    match /registrations/{registrationId} {
      // Kendi kaydını okuyabiliyor — telefon değişince kaydın kaybolmamasının
      // tek yolu bu. `uid` taşımayan eski kayıtlar kimseye açılmıyor:
      // `resource.data.uid` yoksa karşılaştırma null döner ve kural geçmez.
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if false;

      // Yeniden gönderim. Yazma Firestore'a ulaşıp `synced` bayrağı cihaza
      // yazılmadan uygulama ölürse aynı kayıt tekrar gönderiliyor ve doküman
      // artık var olduğu için bu bir *update*. Kapalı olsaydı o kayıt her
      // açılışta yeniden denenip her seferinde reddedilirdi.
      //
      // İzin verilen tek fark `createdAt` — o da sunucu saati olduğu için her
      // yazmada değişiyor. İsim, numara, kod: hiçbiri değiştirilemiyor. Yani
      // başka bir cihazdan gelen *farklı* bir kayıt bu dala düşemiyor.
      //
      // BEDELİ: hesabıyla kaydolup sonra ÇIKIŞ YAPAN ve o sırada eşitlenmemiş
      // bir kaydı olan kullanıcının yeniden gönderimi artık reddediliyor —
      // `request.auth` yok, `resource.data.uid` var. Dar bir durum ve çıkışı
      // var (tekrar giriş yap), ama sessiz değil: istemci `permission-denied`
      // aldığında arka plan denemesini durdurup ekrana elle gönderme düğmesi
      // koyuyor. Oracle'ı açık bırakmak yerine bu kabul edildi.
      //
      // KALAN VARLIK ORAKÜLÜ: dal kimlik istemediği için "bu öğrenci bu
      // etkinliğe kayıtlı mı" sorusu dışarıdan sorulabiliyor — var olmayan
      // dokümanda update reddediliyor, var olanda geçiyor. `uid` taşıyan
      // kayıtlarda kapandı; taşımayanlar mağazadaki hesapsız sürümün yazdığı
      // satırlar ve o sürüm emekli olunca kendiliğinden kapanacak. `uid`'i
      // BUGÜN zorunlu kılmak, kural yayınlandığı saniyede o sürümü kullanan
      // herkesin yeniden gönderimini reddeder.
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt'])
        && (
          !('uid' in resource.data.keys())
          || (request.auth != null && resource.data.uid == request.auth.uid)
        )
        // `createdAt` sunucu saati olmak zorunda: istemcinin seçtiği bir damga
        // kaydı ileri tarihe atıp sıralamayı bozabilirdi.
        && request.resource.data.createdAt == request.time;

      allow create: if
        // Beklenen alanlar dışında bir şey yazılamasın.
        //
        // `uid` İSTEĞE BAĞLI, ve bu geçici bir durum: mağazada şu anda hesabı
        // olmayan bir sürüm var. `uid`'i zorunlu kılmak, o sürümü kullanan
        // herkesin kaydını anında reddeder — kural yayınlandığı saniyede
        // üretim kırılır. Yeni sürüm yayılınca zorunluya çevrilecek.
        //
        // Yine de yazılan `uid` yazana ait olmak zorunda: kimliksiz kayıt
        // serbest, ama BAŞKASININ kimliğiyle kayıt serbest değil.
        request.resource.data.keys().hasOnly(
          ['regId', 'seatId', 'eventId', 'code', 'name', 'studentNo', 'department', 'year', 'createdAt', 'uid']
        )
        && (
          !('uid' in request.resource.data.keys())
          || (request.auth != null && request.resource.data.uid == request.auth.uid)
        )
        // Doküman kimliği öğrenci numarasından türüyor: aynı numara aynı
        // etkinliğe ikinci kez yazılamasın. İkinci yazma var olan dokümana denk
        // gelir ve yukarıdaki update dalı yalnızca birebir aynı kaydı geçirir.
        //
        // Bu kontrol olmadan istemci kimliği kendi seçer ve benzersizlik diye
        // bir şey kalmaz.
        && registrationId == request.resource.data.eventId + '__' + request.resource.data.studentNo
        && request.resource.data.regId == registrationId
        && request.resource.data.seatId is string
        && request.resource.data.seatId.size() >= 8
        && request.resource.data.seatId.size() <= 64
        && request.resource.data.eventId is string
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 80
        // Öğrenci numarası tam 9 hane.
        && request.resource.data.studentNo is string
        && request.resource.data.studentNo.matches('^[0-9]{9}$')
        && request.resource.data.department is string
        && request.resource.data.year is string;
    }

    // Koltuklar: etkinlik başına koltuk jetonları.
    //
    // Okuma açık — uygulama kalan yeri buradan hesaplıyor. Sızan tek şey rastgele
    // üretilmiş jetonların listesi; kayıtların kendisi (isim, öğrenci no) hâlâ
    // tamamen kapalı. Kayıt dokümanının kimliği buraya konamazdı: içinde
    // öğrenci numarası geçiyor ve dokuz haneli bir numara kaba kuvvetle
    // bulunabilir.
    //
    // Sayaç yerine liste tutmanın sebebi: `arrayUnion` aynı jetonu ikinci kez
    // eklemiyor. Yeniden gönderim sayıyı şişirmiyor. `increment(1)` olsaydı,
    // kayıt yazması idempotent olduktan sonra bile aynı çökme penceresinde iki
    // kez artabilirdi.
    //
    // Doküman panelden doğuyor (Admin SDK); istemci sadece kendi kimliğini
    // ekleyebiliyor, silemiyor.
    match /eventSeats/{eventId} {
      allow read: if true;
      allow delete: if false;

      // Doküman normalde panelden doğuyor. Yine de create açık: eski bir
      // etkinliğin koltuk dokümanı yoksa `set(..., {merge:true})` bir create
      // olur ve kapalı olsaydı o etkinliğe hiç kimse kayıt olamazdı — sessiz
      // değil, tam bir çökme. İlk koltuk, var olan bir etkinlik için.
      allow create: if
        request.resource.data.keys().hasOnly(['eventId', 'seatIds'])
        && request.resource.data.eventId == eventId
        && request.resource.data.seatIds is list
        && request.resource.data.seatIds.size() == 1
        && exists(/databases/$(database)/documents/events/$(eventId));

      allow update: if
        request.resource.data.keys().hasOnly(['eventId', 'seatIds'])
        && request.resource.data.eventId == eventId
        && request.resource.data.seatIds is list
        // Hiçbir kimlik silinemesin: başkasının koltuğunu boşaltmak, kontenjanı
        // dolmuş bir etkinliğe yer açmak demek olurdu.
        && request.resource.data.seatIds.hasAll(resource.data.seatIds)
        // Tek seferde en fazla bir koltuk. `arrayUnion` var olan kimliği
        // eklemediği için aynı kalması da geçerli.
        && request.resource.data.seatIds.size() <= resource.data.seatIds.size() + 1
        // Sınır yok değil: 5000 koltuk hiçbir kulüp etkinliğinde olmaz ve
        // dokümanın 1 MiB sınırının çok altında.
        && request.resource.data.seatIds.size() <= 5000;
    }
    // KALAN AÇIK: bu kural bir koltuğun gerçekten bir kayda karşılık geldiğini
    // doğrulamıyor. Elle istek atan biri uydurma kimlikler ekleyip etkinliği
    // dolu gösterebilir. Kayıtların kendisine erişemez, sadece sayıyı şişirir
    // ve panelden "sayacı gerçek kayıtlara eşitle" ile geri alınır.
    //
    // Kapatmanın yolu, koltuk dokümanına eklenen kimliğin aynı batch'te yazılan
    // kaydı işaret etmesini şart koşmak (`getAfter` ile). Yazılmadı çünkü yanlış
    // yazılmış bir `getAfter` bütün kayıtları engeller ve bu depoda kuralları
    // çalıştırıp doğrulayacak bir ortam yok. Eklenecekse önce Firestore
    // emülatöründe denenmeli.

    // Cihazlar: push token'ı ve bildirim tercihleri. `npm run push` kimin neyi
    // istediğini buradan okur.
    //
    // Doküman kimliği push token'ın kendisi. Giriş olmadığı için "bu senin
    // dokümanın mı" diye soran bir kural yazılamıyor; elde olan koruma token'ın
    // tahmin edilemez olması — bir cihaz ancak zaten sahip olduğu token'ın
    // üzerine yazabilir. Okuma istemciye tamamen kapalı: token listesi
    // sızarsa herkes herkese bildirim gönderebilir. Gönderici script Admin
    // SDK kullanıyor, bu kuralları hiç görmüyor.
    match /devices/{token} {
      allow read: if false;
      allow delete: if false;

      allow create, update: if
        request.resource.data.keys().hasOnly(
          ['token', 'platform', 'master', 'categories', 'reminder', 'quietHours', 'updatedAt']
        )
        // Başka bir cihazın kaydının üzerine yazılamasın.
        && request.resource.data.token == token
        // JETON BİÇİMİ: koleksiyon kimliksiz yazmaya açık (cihaz kaydı
        // girişten önce oluyor), yani biçim denetimi olmadan buraya sınırsız
        // sayıda uydurma doküman yazılabiliyordu. Panelin gönderimi bütün
        // koleksiyonu okuyup Expo'ya yığın hâlinde veriyor: milyonlarca sahte
        // satır push'u tamamen durdurur ve belirti yine "bildirim gelmiyor"
        // olur. Expo'nun kendi biçimi tahmin edilebilir bir dize değil.
        // KÖŞELİ PARANTEZLER KAÇIRILMAK ZORUNDA. `matches()` RE2 kullanıyor ve
        // RE2, POSIX'in "sınıfın ilk karakteri olan ] literaldir" kuralını
        // UYGULAMIYOR: `[]]` boş bir sınıf + bir `]` olarak ayrıştırılıyor ve
        // derlenmiyor. Kaçışlı hâl her lehçede aynı şeyi söylüyor; kural
        // dizesindeki `\\` tek bir ters bölü üretiyor (Firebase'in kendi
        // örneklerindeki `\\s` ile aynı).
        && token.matches('^Expo(nent)?PushToken\\[[A-Za-z0-9_-]{1,64}\\]$')
        && request.resource.data.platform in ['ios', 'android']
        && request.resource.data.master is bool
        && request.resource.data.categories is map
        && request.resource.data.categories.size() <= 20
        && request.resource.data.reminder is string
        && request.resource.data.reminder.size() <= 40
        && request.resource.data.quietHours is bool;
    }

    // Çekiliş tanımı: hangi alanların sorulacağı, kaç kazanan, kazananlar.
    // Uygulama formu bu tanımdan çizdiği için okuma açık; yazma yalnızca
    // yönetim panelinden (Admin SDK, bu kuralları görmez).
    match /raffles/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Çekiliş katılımları. Kayıtlarla aynı mantık: öğrenci kendi katılımını
    // oluşturabilir, kimse kimseninkini okuyamaz veya değiştiremez. Kulüp
    // katılımları panelden CSV olarak indirir.
    match /raffleEntries/{entryId} {
      allow read: if false;
      allow delete: if false;

      // Kayıtlardaki ile aynı gerekçe: yeniden gönderim var olan dokümana denk
      // geliyor ve update sayılıyor. Birebir aynı katılım geçiyor, başkası yok.
      //
      // `uid` taşıyan bir katılıma yalnızca sahibi dokunabiliyor; taşımayan
      // (hesapsız sürümün yazdığı) katılım eskisi gibi açık — o alan zorunlu
      // olsaydı mağazadaki sürüm kural yayınlandığı saniyede kırılırdı.
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt'])
        && (
          !('uid' in resource.data.keys())
          || (request.auth != null && resource.data.uid == request.auth.uid)
        );

      allow create: if
        // `uid` LİSTEDE, ve sebebi silme: hesabını silen kullanıcının çekiliş
        // katılımı adını, telefonunu ve öğrenci numarasını taşıyor, ama
        // `admin/deletion.ts` onu `where('uid','==',uid)` ile arıyor. Alan
        // yasaklıyken sorgu hiçbir şey bulamıyor ve o veri veritabanında
        // kalıyordu — hesap silindi görünürken. `registrations`taki gibi
        // isteğe bağlı: varsa yazana ait olmak zorunda.
        request.resource.data.keys().hasOnly(['entryId', 'eventId', 'values', 'createdAt', 'uid'])
        && (
          !('uid' in request.resource.data.keys())
          || (request.auth != null && request.resource.data.uid == request.auth.uid)
        )
        && request.resource.data.entryId == entryId
        // Var olmayan bir çekilişe katılım yazılamasın.
        && request.resource.data.eventId is string
        && exists(/databases/$(database)/documents/raffles/$(request.resource.data.eventId))
        // Alanlar tanıma göre değiştiği için burada tek tek doğrulanamıyor;
        // kuralların işi kötüye kullanımı engellemek — dev doküman yazmak,
        // beklenmedik anahtar eklemek. Alan bazlı doğrulama şemada.
        && request.resource.data.values is map
        && request.resource.data.values.size() > 0
        && request.resource.data.values.size() <= 12;
    }

    // Hesap profilleri. Yalnızca sahibi okuyor ve yazıyor — ad, telefon,
    // doğum tarihi ve öğrenci numarası burada duruyor, yani sızması KVKK
    // ihlali. Panel de yazıyor (doğrulama anında düzeltilen telefon/numara),
    // ama Admin SDK bu kuralları hiç görmüyor.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // ALAN DENETİMİ BİR SÜS DEĞİL, ve sebebi bu dokümanın dışında.
      //
      // Panel `telefon` ve `ogrenciNo`yu buradan okuyup onlara dayanarak
      // `phoneClaims`/`studentClaims` kaydı SİLİYOR (admin/claims.ts,
      // admin/deletion.ts). Denetimsiz hâlde kullanıcı kendi profiline
      // KURBANIN numarasını yazıp panele başkasının teklik kaydını
      // sildirebiliyordu: numara boşa düşüyor, saldırgan onu alıyor, kurban
      // bir daha kendi numarasıyla doğrulanamıyor. Panel tarafında sahiplik
      // kontrolü eklendi; bu kural ikinci kapı — biçimi tutmayan bir değer
      // buraya hiç giremiyor.
      //
      // Sahiplik tek başına yetmiyordu çünkü doküman kullanıcının KENDİ
      // dokümanı: kural "bu senin mi" diye soruyor, "ne yazdın" diye
      // sormuyordu.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['adSoyad', 'email', 'dogumTarihi', 'telefon', 'ogrenciNo',
           'kvkkOnayAt', 'kosullarOnayAt', 'createdAt']
        )
        && request.resource.data.adSoyad is string
        && request.resource.data.adSoyad.size() >= 3
        && request.resource.data.adSoyad.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        // Telefon `normalizePhone`un ürettiği tek biçim: +90 + on hane.
        && request.resource.data.telefon is string
        && request.resource.data.telefon.matches('^[+]90[0-9]{10}$')
        // Öğrenci numarası tam dokuz hane — `STUDENT_NO_RE` ile aynı.
        && request.resource.data.ogrenciNo is string
        && request.resource.data.ogrenciNo.matches('^[0-9]{9}$')
        && request.resource.data.dogumTarihi is string
        && request.resource.data.dogumTarihi.size() <= 10;

      // Profil silme panelin işi (hesap silme akışı Admin SDK ile temizliyor).
      // İstemciye açılsaydı kullanıcı profilini silip teklik kaydını boşta
      // bırakabilirdi — panel neyi serbest bırakacağını yalnızca buradan okuyor.
      allow delete: if false;
    }

    // Hesap silme talepleri.
    //
    // Silmeyi istemci yapamıyor: kendi kaydını silmek başkasının koltuk
    // dokümanına dokunmayı gerektiriyor. Cloud Functions da yok — Blaze
    // istiyor. Talep buraya yazılıyor, paneldeki yoklayıcı Admin SDK ile
    // temizliyor ve `status`'u `done` yapıyor.
    //
    // Okuma açık ama yalnızca kendi dokümanına: ekran silmenin bittiğini
    // buradan öğreniyor ve Apple "tamamlandı" onayı istiyor.
    match /deletionRequests/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // `hasOnly` OLMADAN istemci panelin iç alanlarını önceden yazabiliyordu
      // (`kaynak`, `doneAt` gibi): panel kendi defterini okurken istemcinin
      // uydurduğu bir değeri kendi yazdığı sanar. Alanlar sabit ve az.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'email', 'status', 'requestedAt']
                       )
                    && request.resource.data.uid == uid
                    && request.resource.data.status == 'pending';
      // Güncelleme paneldeki Admin SDK'nın işi; istemci kendi talebini
      // "bitti" ilan edemesin.
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------- yoklama
    //
    // QR ekranda/afişte duruyor, öğrenci uygulamadan okutuyor. Kodun
    // fotoğraflanıp paylaşılması KABUL EDİLMİŞ bir maliyet — kararın
    // gerekçesi docs/qr-yoklama-plani.md §1'de. Şart olan tek şey okutmanın
    // uygulamada kayıtlı bir hesapla çalışması.
    //
    // `eventQr/{eventId}` istemciye TAMAMEN kapalı. Jeton yine de kurala
    // giriyor: kural değerlendirmesindeki `get()` çağrısı istemcinin okuma
    // izninden GEÇMİYOR, yani jeton hiçbir zaman kabloya çıkmadan
    // karşılaştırılabiliyor. Sunucu, fonksiyon ve Blaze gerektirmemesinin
    // tek sebebi bu.
    match /eventQr/{eventId} {
      allow read, write: if false;
    }

    function qrTanimi(eventId) {
      return get(/databases/$(database)/documents/eventQr/$(eventId)).data;
    }

    match /attendance/{id} {
      // Kendi yoklamasını okuyabiliyor: ekran "katıldın" diyebilsin ve
      // sertifika listesi kendi satırını bulabilsin. Başkasınınki kapalı —
      // kimin hangi etkinliğe geldiği kişisel veri.
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if false;

      // Yeniden gönderim. Salonun interneti en yoğun anda en kötü ve gönderim
      // yeniden deneniyor; ikinci deneme var olan dokümana düşüyor, yani bir
      // *update*. Kapalı olsaydı o telefon kalıcı olarak reddedilirdi.
      //
      // Yalnızca `checkedInAt` değişebiliyor: panelin sonradan yazdığı
      // sertifika alanlarına istemci dokunamasın.
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['checkedInAt']);

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['eventId', 'uid', 'token', 'checkedInAt'])
        // Doküman kimliği birleşik: aynı hesap aynı etkinliğe ikinci kez
        // yazamıyor. Sayaç yok, okuma yok, yarışacak bir şey yok — kayıtlardaki
        // `eventId__studentNo` ile aynı kalıp.
        && id == request.resource.data.eventId + '__' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.eventId is string
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && request.resource.data.checkedInAt is timestamp
        // Jeton, istemcinin OKUYAMADIĞI dokümandan geliyor.
        && request.resource.data.token == qrTanimi(request.resource.data.eventId).token
        // Pencere: etkinliğin bir saat öncesinden o günün sonuna. Bitişte
        // kapatmak, akşam bağlantıya kavuşan telefonu kalıcı olarak reddederdi.
        && request.time >= qrTanimi(request.resource.data.eventId).opensAt
        && request.time <= qrTanimi(request.resource.data.eventId).closesAt;
    }
    // KALAN AÇIK — bilinçli: bu kural "bu hesap pencere açıkken jetonu
    // gönderdi" diyor, "bu kişi salondaydı" demiyor. Kodun paylaşılması
    // engellenmiyor ve sertifikanın üstüne bundan fazlası yazılamaz.

    // Doğrulama kodu ve teklik kayıtları — üçü de tamamen panelin.
    //
    // `emailOtp/{uid}` kodun hash'ini ve deneme sayısını taşıyor. İstemciye
    // açılsaydı kullanıcı kendi deneme sayacını sıfırlayabilirdi, yani beş
    // deneme sınırı diye bir şey kalmazdı.
    //
    // `phoneClaims/{telefon}` ve `studentClaims/{ogrenciNo}`: doküman
    // kimliği değerin kendisi, yani teklik doküman kimliğiyle zorlanıyor —
    // `registrations`'taki `eventId__studentNo` ile aynı kalıp. Yazma
    // panelde çünkü İKİSİ BİRDEN ya da hiçbiri olmak zorunda (bkz.
    // admin/claims.ts); iki ayrı istemci yazması atomik değil ve yarıda kalan
    // hâli kimsenin sahiplenmediği bir kayıt bırakıyor.
    //
    // Okuma kapalı: telefon numarası ve öğrenci numarası kişisel veri, ve
    // liste hâlinde okunabilmeleri doğrudan bir sızıntı. Aşağıdaki catch-all
    // zaten kapatırdı; açıkça yazılmalarının sebebi bir gün "istemci de
    // yazsın" diyen birinin neden yazmaması gerektiğini burada görmesi.
    match /emailOtp/{uid} {
      allow read, write: if false;
    }
    match /phoneClaims/{telefon} {
      allow read, write: if false;
    }
    match /studentClaims/{ogrenciNo} {
      allow read, write: if false;
    }

    // Bildirim otomasyonunun defterleri. Yalnızca panel (Admin SDK) yazıyor;
    // Admin SDK bu kuralları hiç görmüyor, dolayısıyla `false` onu engellemiyor.
    // Aşağıdaki catch-all zaten kapatırdı — açıkça yazılmalarının sebebi, bir
    // gün "istemci de okusun" diyen birinin neden okumaması gerektiğini burada
    // görmesi: `pushLog` hangi duyurunun gittiğini, `pendingPushes` ise
    // gönderilecek token listesini taşıyor.
    match /pushLog/{id} {
      allow read, write: if false;
    }
    match /pendingPushes/{id} {
      allow read, write: if false;
    }

    // Yukarıda eşleşmeyen her şey kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// İÇERİK NASIL GİRİLİR
// `events` ve `archive` istemciye kapalı yazımdır ve öyle kalmalı. İçerik
// yönetim panelinden giriliyor (`npm run admin`); panel Admin SDK kullanır ve
// bu kuralları hiç görmez, dolayısıyla yazmak için kural gevşetmek gerekmez.
//
// Eski `npm run seed` istemci SDK'sı kullanıyor, yani yazma yasağına takılır.
// Kuralı geçici olarak gevşetip geri almayı unutmak, veritabanını herkese açık
// bırakmanın en kolay yolu — o yüzden seed yerine panel kullanın.

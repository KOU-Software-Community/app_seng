legacy-peer-deps=true

# Yayımlanalı 3 günden kısa süre olmuş bir sürüm kurulmuyor.
#
# npm audit açıklanmış danışmaları görüyor; npm'e yapılan gerçek saldırılar
# ise açıklanmadan ÖNCE lockfile'lara giriyor — ele geçirilmiş bir bakımcı
# hesabından yayımlanan, postinstall'da kimlik bilgisi toplayan bir sürüm.
# Bilinen örneklerin hepsi (chalk/debug oltalaması, Shai-Hulud solucanı)
# saatler içinde tespit edilip çekildi; birkaç günlük bir pencere o sürümü
# hiç kurmamak demek. Açıklanmamış bir şeye karşı koruyan tek ayar bu.
#
# Ölçüldü: npm 12'de gerçekten filtreliyor ve HATA VERMİYOR, bir önceki uygun
# sürüme düşüyor (min-release-age=400 ile express 5.2.1 yerine 5.1.0 geldi).
# npm 10 anahtarı okuyor ama yok sayıyor — `npm config get` 3 döndürüyor,
# kurulum exit 0. Yani CI'daki eski npm'de sessizce etkisiz, kırmıyor.
#
# `npm ci` bunu zaten hiç görmüyor: lockfile'ı birebir kuruyor. Ayar yalnızca
# ÇÖZÜMLEME anında — `npm install`, `npm run deps:sync` — ısırıyor, ki yeni
# bir sürümün lockfile'a gireceği an tam olarak orası.
#
# Pencere bir yamayı engellerse npm bunu söyleyip sıfır olmayan kodla çıkıyor;
# acil durumda `--min-release-age=0` ya da `min-release-age-exclude`.
min-release-age=3
